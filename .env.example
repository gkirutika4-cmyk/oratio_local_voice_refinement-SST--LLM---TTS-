# Node server
PORT=8080

# Pipeline services
STT_URL=http://127.0.0.1:9000
TTS_URL=http://127.0.0.1:9001

# 0 = full STT/refine/TTS pipeline
# 1 = upload-only debug mode
UPLOAD_ONLY=0

# Coqui TTS device
# Use cpu for most laptops, cuda if you have NVIDIA GPU support
DEVICE=cpu

# Optional voice clone reference file
# Only use your own voice or a voice you have permission to clone.
# SPEAKER_WAV=voice_samples/reference.wav